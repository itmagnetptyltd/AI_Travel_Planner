{
  "$schema": "../schema/adapter.schema.json",
  "id": "python",
  "displayName": "Python",
  "detect": ["**/pyproject.toml", "**/setup.py", "**/setup.cfg"],
  "sourceGlobs": ["**/*.py"],
  "testGlobs": [
    "**/test_*.py",
    "**/*_test.py",
    "**/tests/**/*.py"
  ],
  "e2eGlobs": [
    "**/e2e/**/*.py",
    "**/tests/e2e/**/*.py"
  ],
  "apiGlobs": [
    "**/tests/api/**/*.py",
    "**/*_http_test.py",
    "**/*_api_test.py"
  ],
  "ignore": [
    "**/__pycache__/**",
    "**/.venv/**",
    "**/venv/**",
    "**/.pytest_cache/**",
    "**/dist/**",
    "**/*.egg-info/**"
  ],
  "annotation": {
    "pattern": "#\\s*@covers\\s+(REQ-[A-Z]{3,8}-\\d{3})(?:@v(\\d+))?",
    "example": "# @covers REQ-SAMPLE-001@v1"
  },
  "commands": {
    "build": "python -m compileall -q .",
    "test": "pytest -q",
    "lint": "ruff check .",
    "coverage": "pytest --cov --cov-fail-under=80 -q",
    "format": "ruff format {file}",
    "e2e": "pytest -q tests/e2e",
    "integration": "pytest -q -m integration"
  },
  "ci": {
    "container": "python:3.12-bookworm"
  },
  "rules": "rules/python"
}
