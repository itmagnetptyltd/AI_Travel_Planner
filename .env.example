# Copy to .env for local development. Never commit .env.
PORT=3000
HOST=127.0.0.1
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=data/trv.sqlite
# smtp (Mailpit locally: host 127.0.0.1, port 1025) or file
EMAIL_TRANSPORT=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_OUTBOX_DIR=
COOKIE_SECURE=true
AUTH_RATE_LIMIT_PER_MINUTE=20
# AI planner. anthropic calls the provider; scripted is for the browser tests and only starts when NODE_ENV=test.
AI_PROVIDER=anthropic
# Server-side only. Never put this in anything served to the browser.
AI_API_KEY=
AI_MODEL=
# Price of the chosen model, in millionths of a US dollar per million tokens (for example $5 = 5000000)
AI_INPUT_COST_MICRO_USD_PER_MTOK=
AI_OUTPUT_COST_MICRO_USD_PER_MTOK=
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=16000
AI_DESTINATION_TEXT_MAX_CHARS=2000
