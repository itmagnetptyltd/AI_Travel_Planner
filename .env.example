# Copy to .env for local development. Never commit .env.
PORT=3000
HOST=127.0.0.1
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=data/trv.sqlite
# smtp (Mailpit locally: host 127.0.0.1, port 1025) or file
EMAIL_TRANSPORT=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_OUTBOX_DIR=
COOKIE_SECURE=true
AUTH_RATE_LIMIT_PER_MINUTE=20
